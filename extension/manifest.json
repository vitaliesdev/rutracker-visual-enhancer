{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "__MSG_extensionShortName__",
  "version": "1.1.0",
  "minimum_chrome_version": "105",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "options.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://rutracker.org/*",
        "https://*.rutracker.org/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "theme-bootstrap.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://rutracker.org/*",
        "https://*.rutracker.org/*"
      ],
      "js": [
        "runtime-i18n.js",
        "support.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
